{
    "name": "restomanager/app",
    "description": "Aplikasi pemesanan restoran walk-in untuk demonstrasi BNSP.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:foundation": "php tests/Support/foundation_check.php"
    },
    "config": {
        "sort-packages": true
    }
}
